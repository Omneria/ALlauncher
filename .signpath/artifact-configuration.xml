<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artifact SignPath pour AL Launcher : à coller dans le projet SignPath
  (Project → Artifact Configurations → "initial" → Edit), voir .signpath/README.md.

  L'artifact envoyé par la CI est le zip "MinecraftLauncherPerso-win-x64-selfcontained" produit
  par actions/upload-artifact : il contient un seul fichier, l'exe autonome "AL Launcher.exe".
  Les restrictions product-name/company-name vérifient les métadonnées posées par le csproj
  (<Product>, <Company>) : un autre exe glissé dans l'artifact serait refusé à la signature.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="AL Launcher.exe" product-name="AL Launcher" company-name="Omneria">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
