# Caddy : sert le dossier modpack en HTTPS avec un certificat Let's Encrypt obtenu et renouvelé
# automatiquement pour le domaine DuckDNS (voir README.md, section "Passage en HTTPS").
#
# Prérequis : le domaine pointe sur ce VPS (déjà le cas, c'est ServerHost du launcher), les ports
# 80 ET 443 sont ouverts dans le pare-feu (80 sert au défi ACME), et aucun autre serveur web
# n'écoute sur 80/443.

# Contenu servi, partagé par les deux blocs ci-dessous.
(modpack) {
    # Racine du site : doit contenir le dossier modpack/ (manifest.json, files/, news.txt,
    # maintenance.txt, Algaron-modded.zip). Adapter si le dossier réel est ailleurs.
    root * /var/www/html

    # Sert les fichiers tels quels, sans listing des dossiers. Caddy gère nativement les
    # requêtes Range (reprise du téléchargement du zip).
    file_server

    # Pas de mise en cache intermédiaire des petits fichiers qui changent souvent.
    @dynamic path /modpack/manifest.json /modpack/maintenance.txt /modpack/news.txt
    header @dynamic Cache-Control "no-cache"

    encode gzip
}

# Launchers v1.11.0 et suivants : HTTPS sur le nom de domaine, certificat automatique.
astralnexusmc.duckdns.org {
    import modpack
}

# Launchers v1.10.0 et antérieurs : ils contactent encore http://<IP>/modpack/... en clair.
# Sans ce bloc, Caddy ne répondrait qu'au nom de domaine et tous les joueurs pas encore mis à
# jour ne pourraient plus synchroniser le modpack. À supprimer quand plus personne n'est en
# v1.10.0 ou avant. Remplacer l'IP si le VPS change.
http://185.185.82.180 {
    import modpack
}
