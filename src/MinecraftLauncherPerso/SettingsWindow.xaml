<Window x:Class="MinecraftLauncherPerso.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="480" Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/algaron-mark.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="P A R A M È T R E S" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{StaticResource InkDimBrush}" />

            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,4,28,20">
            <TextBlock Text="RAM MINIMUM (MO)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="MinRamTextBox" Style="{StaticResource AlgaronTextBoxStyle}" Margin="0,0,0,16" />

            <TextBlock Text="RAM MAXIMUM (MO)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="MaxRamTextBox" Style="{StaticResource AlgaronTextBoxStyle}" Margin="0,0,0,16" />

            <TextBlock Text="RÉSOLUTION DU JEU (0 = automatique)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScreenWidthTextBox" Grid.Column="0" Style="{StaticResource AlgaronTextBoxStyle}" />
                <TextBox x:Name="ScreenHeightTextBox" Grid.Column="2" Style="{StaticResource AlgaronTextBoxStyle}" />
            </Grid>

            <TextBlock Text="DOSSIER DE JEU" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDirectoryTextBox" Grid.Column="0" Style="{StaticResource AlgaronTextBoxStyle}"
                         IsReadOnly="True" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="PARCOURIR" Style="{StaticResource GhostButtonStyle}" Width="Auto"
                        Padding="12,7" FontSize="11" Click="BrowseButton_Click" />
            </Grid>

            <Button Content="ENREGISTRER" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
