<Window x:Class="MinecraftLauncherPerso.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="480" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/omneria-mark.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="P A R A M È T R E S" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{StaticResource InkDimBrush}" />

            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,4,28,20">
            <!-- Un seul slider à deux poignées (au lieu de deux sliders min/max séparés) : la
                 poignée gauche ne peut pas dépasser la droite et inversement (contrainte
                 appliquée en direct dans les Drag* ci-dessous), plage bornée par la RAM physique
                 réelle de la machine (voir constructeur) — par construction, impossible de
                 configurer une plage invalide. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RAM (MO)" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock x:Name="RamRangeValueText" Grid.Column="1" FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11" Foreground="{StaticResource InkDimBrush}" />
            </Grid>
            <Canvas x:Name="RamRangeCanvas" Height="20" Margin="0,6,0,16"
                    SizeChanged="RamRangeCanvas_SizeChanged">
                <Border x:Name="RamRangeTrack" Height="4" Canvas.Top="8" Background="{StaticResource Surface2Brush}" />
                <Border x:Name="RamRangeFill" Height="4" Canvas.Top="8" Background="{StaticResource CyanBrush}" />
                <Thumb x:Name="RamMinThumb" Width="14" Height="14" Canvas.Top="3" Cursor="Hand"
                       AutomationProperties.Name="RAM minimum" DragDelta="RamMinThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Fill="{StaticResource CyanBrush}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="RamMaxThumb" Width="14" Height="14" Canvas.Top="3" Cursor="Hand"
                       AutomationProperties.Name="RAM maximum" DragDelta="RamMaxThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Fill="{StaticResource CyanBrush}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>

            <TextBlock Text="RÉSOLUTION DU JEU (0 = automatique)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScreenWidthTextBox" Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" />
                <TextBox x:Name="ScreenHeightTextBox" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" />
            </Grid>

            <TextBlock Text="DOSSIER DE JEU" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDirectoryTextBox" Grid.Column="0" Style="{StaticResource AppTextBoxStyle}"
                         IsReadOnly="True" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="PARCOURIR" Style="{StaticResource GhostButtonStyle}" Width="Auto"
                        Padding="12,7" FontSize="11" Click="BrowseButton_Click" />
            </Grid>

            <CheckBox x:Name="DesktopNotificationsCheckBox" Content="NOTIFICATIONS DESKTOP (SERVEUR EN LIGNE)"
                      Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,0,16" />

            <!-- Maintenance (v1.9.0) : réparation du modpack et visualiseur de logs, jusqu'ici
                 accessibles uniquement en cas de plantage (ViewLogsButton) ou pas du tout
                 (aucun moyen manuel de forcer une resynchro sans supprimer le dossier de jeu à la main). -->
            <TextBlock Text="MAINTENANCE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RepairButton" Grid.Column="0" Content="RÉPARER LE MODPACK"
                        Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="0,7" FontSize="11"
                        Click="RepairButton_Click" />
                <Button x:Name="ViewLogsButton" Grid.Column="2" Content="VOIR LES LOGS"
                        Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="0,7" FontSize="11"
                        Click="ViewLogsButton_Click" />
            </Grid>
            <TextBlock x:Name="RepairStatusText" FontSize="11" Foreground="{StaticResource InkDimBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed" />

            <!-- Auparavant une saisie invalide (texte non numérique, RAM min > max...) était
                 silencieusement ignorée : le champ gardait sa valeur précédente sans aucun retour,
                 donnant l'impression que "ça n'enregistrait pas" sans dire pourquoi. -->
            <TextBlock x:Name="ValidationErrorText" Foreground="{StaticResource MagentaBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="MENTIONS LÉGALES" HorizontalAlignment="Left"
                        Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="0"
                        FontSize="11" Foreground="{StaticResource InkDimBrush}"
                        Click="LegalButton_Click" />

                <Button Grid.Column="1" Content="ENREGISTRER" Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
