<Window x:Class="MinecraftLauncherPerso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Omnéria Launcher"
        Width="1240" Height="600"
        MinWidth="620" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/omneria-mark.png">
    <!-- WindowChrome (plutôt que le ResizeMode seul) : sans chrome Windows natif
         (WindowStyle="None"), un simple ResizeMode="CanResize" ne donne aucune bordure
         attrapable à la souris — WindowChrome restaure des bords redimensionnables sur une
         fenêtre sans chrome, sans reprendre la barre de titre (CaptionHeight="0" laisse
         TitleBar_MouseLeftButtonDown/DragMove ci-dessous gérer le déplacement comme avant). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Triggers>
        <!-- Halos en respiration lente et continue (dérive + pulsation d'opacité) : signature
             discrète, jamais assez rapide pour distraire de l'UI. -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="-40" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="30" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="35" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="-25" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:11" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <!-- Halo de fond (signature Omnéria) : deux dégradés radiaux, violet et cyan. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="VioletHalo" Canvas.Left="380" Canvas.Top="-260" Width="620" Height="480">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#337B5CFF" Offset="0" />
                        <GradientStop Color="#007B5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="CyanHalo" Canvas.Left="-160" Canvas.Top="-60" Width="480" Height="360">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2200E5C7" Offset="0" />
                        <GradientStop Color="#0000E5C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) : plus de marque ici,
                 elle vit désormais dans la barre latérale ci-dessous (piste "Fusion" v1.5.0). -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CompactModeButton" Content="⤢" Style="{StaticResource GhostButtonStyle}"
                            ToolTip="Mode compact" AutomationProperties.Name="Basculer le mode compact"
                            Click="CompactModeButton_Click" />
                    <Button Content="—" Style="{StaticResource GhostButtonStyle}" Click="MinimizeButton_Click"
                            ToolTip="Réduire" AutomationProperties.Name="Réduire la fenêtre" />
                    <Button Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click"
                            ToolTip="Fermer" AutomationProperties.Name="Fermer le launcher" />
                </StackPanel>
            </Grid>

            <!-- Contenu principal : barre latérale fixe + tableau de bord deux colonnes. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Barre latérale : marque, navigation (seul JOUER est un vrai écran pour
                     l'instant ; ACTUS/SERVEUR restent décoratifs, PARAMÈTRES ouvre la fenêtre
                     existante), profil connecté en bas. -->
                <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" />

                    <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,14,0,18">
                        <Image Source="/Assets/Images/omneria-mark.png" Width="130" Height="130" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Row="1">
                        <Border x:Name="NavJouer" Padding="14,10" BorderThickness="2,0,0,0"
                                BorderBrush="{StaticResource CyanBrush}" Background="#1200E5C7">
                            <TextBlock Text="HUB" Style="{StaticResource NavItemActiveTextStyle}" />
                        </Border>
                        <!-- ACTUS/SERVEUR n'ouvrent pas un écran séparé (tout est déjà sur le tableau
                             de bord) : cliquer fait défiler jusqu'à la carte correspondante et la fait
                             pulser brièvement, pour que ces items ne soient plus de faux boutons inertes. -->
                        <Border x:Name="NavActus" Padding="14,10" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                Cursor="Hand" Focusable="True" AutomationProperties.Name="Actus"
                                MouseLeftButtonUp="ActusNavItem_MouseLeftButtonUp" KeyDown="NavItem_KeyDown">
                            <TextBlock Text="ACTUS" Style="{StaticResource NavItemTextStyle}" />
                        </Border>
                        <Border x:Name="NavServeur" Padding="14,10" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                Cursor="Hand" Focusable="True" AutomationProperties.Name="Statut du serveur"
                                MouseLeftButtonUp="ServeurNavItem_MouseLeftButtonUp" KeyDown="NavItem_KeyDown">
                            <TextBlock Text="SERVEUR" Style="{StaticResource NavItemTextStyle}" />
                        </Border>
                        <Border x:Name="NavParametres" Padding="14,10" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                Cursor="Hand" Focusable="True" AutomationProperties.Name="Paramètres"
                                MouseLeftButtonUp="ParametresNavItem_MouseLeftButtonUp" KeyDown="NavItem_KeyDown">
                            <TextBlock Text="PARAMÈTRES" Style="{StaticResource NavItemTextStyle}" />
                        </Border>
                    </StackPanel>

                    <!-- Bloc profil connecté (agrandi) : SE CONNECTER tant qu'aucun compte n'est
                         actif, remplacé par avatar + pseudo + badge une fois connecté. -->
                    <Grid Grid.Row="3" Margin="0,0,0,0">
                        <Border Padding="18,16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}"
                                Background="#0A00E5C7">
                            <StackPanel>
                                <Button x:Name="LoginButton" Content="SE CONNECTER" HorizontalAlignment="Stretch"
                                        Style="{StaticResource GhostButtonStyle}" Width="Auto" Height="Auto"
                                        Padding="0,10" FontSize="11" Foreground="{StaticResource CyanBrush}"
                                        Click="LoginButton_Click" />

                                <StackPanel x:Name="SidebarAccountPanel" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="PlayerAvatarBorder" Width="44" Height="44" Margin="0,0,12,0"
                                                BorderBrush="{StaticResource CyanBrush}" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Modifier mon skin Minecraft"
                                                AutomationProperties.Name="Modifier mon skin Minecraft"
                                                MouseLeftButtonUp="PlayerAvatarBorder_MouseLeftButtonUp"
                                                Visibility="Collapsed">
                                            <Image x:Name="PlayerAvatarImage" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PlayerNameText" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <TextBlock x:Name="AvatarErrorHint" Text="⚠" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{StaticResource MagentaBrush}"
                                                           Visibility="Collapsed" Cursor="Help" />
                                            </StackPanel>
                                            <Border Margin="0,5,0,0" BorderBrush="{StaticResource CyanBrush}"
                                                    BorderThickness="1" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="CONNECTÉ" FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="9" Foreground="{StaticResource CyanBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="VersionText" Margin="0,12,0,0"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                           Foreground="{StaticResource InkDimBrush}" />
                                <TextBlock x:Name="LastSyncText" Margin="0,2,0,0"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                           Foreground="{StaticResource InkDimBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Tableau de bord : en-tête (serveur + bandeau MAJ), puis deux colonnes
                     (actus/changelog à gauche, statut serveur + lancement à droite). -->
                <Grid Grid.Column="1" Margin="26,22,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Marge portée par le bouton (pas par la ligne) : la ligne ne contient que ce
                         bouton, masqué 99 % du temps — une marge sur la ligne laissait 16 px de vide
                         permanent en haut du tableau de bord. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpdateBannerButton" Grid.Column="1" Content="MISE À JOUR DISPONIBLE"
                                Visibility="Collapsed" Margin="0,0,0,16"
                                AutomationProperties.Name="Installer la mise à jour du launcher"
                                Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="10,4"
                                FontSize="11" Foreground="{StaticResource AmberBrush}"
                                Click="UpdateBannerButton_Click" />
                    </Grid>

                    <!-- Bannière de maintenance (v1.9.0, optionnelle) : "carte console" magenta
                         (option B retenue) — plus imposante que les bandeaux discrets déjà en place
                         (mise à jour du launcher, etc.) puisqu'elle porte une information dont
                         l'absence de lecture a un vrai coût (jouer alors que le serveur va couper).
                         Coins coupés en biseau (comme le mockup Option B et PrimaryButtonTemplate) :
                         points fixes (même repère 700x120 que le mockup), étirés par Stretch="Fill"
                         nativement par WPF pour épouser la largeur variable de la colonne. Un calcul
                         dynamique des points via SizeChanged a été essayé puis retiré (v1.9.2) : il
                         réinvalidait la mesure du Polygon à chaque changement de taille alors que ce
                         Polygon est dans la même cellule Auto que celle qui détermine la hauteur de
                         la bannière, ce qui a cassé l'affichage de tout le dashboard en production.
                         Collapsed tant qu'aucun maintenance.txt n'est détecté. -->
                    <Grid x:Name="MaintenanceBanner" Grid.Row="1" Margin="0,0,0,16" Visibility="Collapsed">
                        <Polygon Points="14,0 700,0 700,106 686,120 0,120 0,14" Stretch="Fill"
                                 Fill="{StaticResource SurfaceBrush}"
                                 Stroke="{StaticResource MagentaBrush}" StrokeThickness="1.5" />
                        <Grid Margin="24,18,24,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="26" Height="26" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Path Data="M12 8v4 M12 16h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                                          Stroke="{StaticResource MagentaBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="24" Height="24" Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="SERVEUR EN MAINTENANCE" Style="{StaticResource EyebrowTextStyle}"
                                               Foreground="{StaticResource MagentaBrush}" FontSize="11" />
                                    <TextBlock x:Name="MaintenanceBannerTitle" FontFamily="{StaticResource DisplayFontFamily}"
                                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="MaintenanceBannerSubtitle" FontSize="12"
                                               Foreground="{StaticResource InkDimBrush}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Optionnelle : n'apparaît que si maintenance.txt contient une ligne
                                 "FIN: <valeur>" (voir RefreshMaintenanceBannerAsync). -->
                            <StackPanel x:Name="MaintenanceBannerEndTimeBlock" Grid.Column="1"
                                        VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="FIN ESTIMÉE" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource InkDimBrush}" FontSize="10"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="MaintenanceBannerEndTimeValue"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="22"
                                           FontWeight="Medium" Foreground="{StaticResource MagentaBrush}"
                                           HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <!-- x:Name sur les 3 colonnes : le mode compact (CompactModeButton_Click)
                                 réduit NewsColumn/GapColumn à 0 pour ne garder que la colonne serveur,
                                 plutôt que de dupliquer toute cette mise en page dans une seconde vue. -->
                            <ColumnDefinition x:Name="NewsColumn" Width="1.3*" />
                            <ColumnDefinition x:Name="GapColumn" Width="18" />
                            <ColumnDefinition x:Name="ServerColumn" Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Colonne gauche : ACTUS (news.txt, VPS) et CHANGELOG (releases GitHub) sont
                             deux sources indépendantes, jusqu'ici affichées dans une même carte
                             "ACTUS & CHANGELOG" qui ne montrait en réalité que les actus — séparées
                             en deux cartes empilées. -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Actus (news.txt optionnel) : carte toujours visible, avec un état vide
                                 explicite plutôt que de disparaître entièrement (la mise en page
                                 suppose sa présence). -->
                            <Border x:Name="NewsCardBorder" Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="NewsCardScale" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="ACTUS" Style="{StaticResource EyebrowTextStyle}"
                                               Margin="18,16,18,8" />
                                    <!-- Historique (pas juste la dernière actu) : news.txt côté VPS est un simple
                                         fichier "à plat" sans historique propre, donc chaque contenu distinct
                                         observé est horodaté et conservé localement (NewsHistoryStore) plutôt que
                                         remplacé à chaque rafraîchissement. -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="18,0,18,16">
                                            <TextBlock x:Name="NewsEmptyText" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Text="Aucune actualité pour le moment." />
                                            <ItemsControl x:Name="NewsHistoryList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,16">
                                                            <TextBlock Text="{Binding FetchedAtLabel}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="10" Foreground="{StaticResource InkDimBrush}"
                                                                       Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                       FontFamily="{StaticResource BodyFontFamily}"
                                                                       FontSize="13" Foreground="{StaticResource InkBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Changelog : releases GitHub du launcher (même source et mêmes règles
                                 de nettoyage des notes que la carte "Changelog" de la landing page),
                                 pas un fichier changelog.txt séparé à maintenir côté VPS. -->
                            <Border x:Name="ChangelogCardBorder" Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CHANGELOG" Style="{StaticResource EyebrowTextStyle}"
                                               Margin="18,16,18,8" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="18,0,18,16">
                                            <TextBlock x:Name="ChangelogEmptyText" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                                       Foreground="{StaticResource InkDimBrush}"
                                                       Text="Notes de version indisponibles pour le moment."
                                                       Visibility="Collapsed" />
                                            <ItemsControl x:Name="ChangelogList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,16">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <!-- Numéro de version cliquable (FrameworkElement.Tag porte
                                                                     l'URL de la release) : la carte ne montre que 4 notes
                                                                     nettoyées, le détail complet et l'exe restent sur GitHub. -->
                                                                <TextBlock Text="{Binding VersionTag}" Tag="{Binding Url}"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontWeight="Bold" FontSize="13"
                                                                           Foreground="{StaticResource InkBrush}"
                                                                           Cursor="Hand" TextDecorations="Underline"
                                                                           ToolTip="Ouvrir cette version sur GitHub"
                                                                           MouseLeftButtonUp="ChangelogVersion_MouseLeftButtonUp" />
                                                                <Border Margin="8,0,0,0" Padding="5,1" BorderThickness="1"
                                                                        BorderBrush="{StaticResource CyanBrush}"
                                                                        Visibility="{Binding LatestBadgeVisibility}">
                                                                    <TextBlock Text="DERNIÈRE"
                                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                                               FontSize="9" Foreground="{StaticResource CyanBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DateLabel}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="10" Foreground="{StaticResource InkDimBrush}"
                                                                       Margin="0,0,0,6" />
                                                            <ItemsControl ItemsSource="{Binding Notes}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                            <TextBlock Text="—" Foreground="{StaticResource CyanBrush}"
                                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top" />
                                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                                       FontFamily="{StaticResource BodyFontFamily}"
                                                                                       FontSize="12" Foreground="{StaticResource InkBrush}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Colonne serveur + lancement -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Carte statut serveur : crest à droite, occupant toute la hauteur
                                 disponible, jamais coincé au niveau du texte "EN LIGNE". -->
                            <Border x:Name="ServerCardBorder" Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                                    Padding="14" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ServerCardScale" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Nom du serveur déplacé ici (depuis l'en-tête du tableau de bord) :
                                             cette carte est la seule vraiment spécifique à Astral Nexus, l'en-tête
                                             au-dessus concerne tout le dashboard. -->
                                        <TextBlock x:Name="ServerNameText" Style="{StaticResource EyebrowTextStyle}"
                                                   Margin="0,0,0,8" Text="ASTRAL NEXUS" />
                                        <!-- Background="Transparent" (plutôt que laissé à null) : sans ça, le
                                             survol entre la pastille et le texte ne déclenche pas le tooltip
                                             (zone non hit-testable en WPF quand Background est absent). -->
                                        <StackPanel x:Name="ServerStatusRow" Orientation="Horizontal" Margin="0,0,0,8"
                                                    Background="Transparent" ToolTipService.InitialShowDelay="300">
                                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{StaticResource CyanBrush}" Margin="0,0,8,0" />
                                            <TextBlock x:Name="ServerStatusText" VerticalAlignment="Center"
                                                       Text="Vérification..." FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Foreground="{StaticResource InkDimBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ServerCountText" FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                        <TextBlock Text="JOUEURS CONNECTÉS" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5"
                                                   Foreground="{StaticResource InkDimBrush}" />
                                    </StackPanel>
                                    <Image Grid.Column="2" Source="/Assets/Images/astral-nexus-crest.png"
                                           Width="116" Height="116" Stretch="UniformToFill" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Panneau de chargement : masqué au repos, affiche un spinner + le
                                 statut de l'étape en cours pendant le lancement/la mise à jour. -->
                            <Border x:Name="LoadingPanel" Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                                    Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{StaticResource ColorCyan}" Offset="0" />
                                                <GradientStop Color="{StaticResource ColorViolet}" Offset="0.5" />
                                                <GradientStop Color="{StaticResource ColorMagenta}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="12">
                                        <Ellipse x:Name="LoadingSpinner" Width="30" Height="30" StrokeThickness="3"
                                                 Stroke="{StaticResource CyanBrush}" StrokeDashArray="4,3"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="LoadingSpinnerRotation" />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="LoadingSpinnerRotation"
                                                                              Storyboard.TargetProperty="Angle"
                                                                              From="0" To="360" Duration="0:0:1.1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock x:Name="LoadingStatusText" Margin="0,12,0,0"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                   Foreground="{StaticResource InkDimBrush}" Text="Préparation..." />
                                        <!-- Visible seulement pendant le pipeline de lancement (pas pendant
                                             une mise à jour du launcher) : interrompt l'étape en cours. -->
                                        <Button x:Name="CancelLaunchButton" Content="ANNULER" Margin="0,12,0,0"
                                                HorizontalAlignment="Center" Visibility="Collapsed"
                                                AutomationProperties.Name="Annuler le lancement"
                                                Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="12,5"
                                                FontSize="11" Foreground="{StaticResource MagentaBrush}"
                                                Click="CancelLaunchButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Barre de contrôle : progression, bouton Jouer, logs -->
                            <StackPanel Grid.Row="2">
                                <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,0,0,14"
                                             Minimum="0" Maximum="100"
                                             Background="{StaticResource Surface2Brush}" BorderThickness="0"
                                             Foreground="{StaticResource CyanBrush}" />

                                <Button x:Name="PlayButton" Content="JOUER" HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="PlayButton_Click" />

                                <Button x:Name="ViewLogsButton" Content="VOIR LES LOGS" Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed"
                                        Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="12,6"
                                        FontSize="11" Foreground="{StaticResource MagentaBrush}"
                                        Click="ViewLogsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
