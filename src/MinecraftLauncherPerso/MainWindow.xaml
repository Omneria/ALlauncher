<Window x:Class="MinecraftLauncherPerso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MinecraftLauncherPerso.Controls"
        Title="Omnéria Games"
        Width="1280" Height="720"
        MinWidth="620" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/omneria-mark.png">
    <!-- WindowChrome (plutôt que le ResizeMode seul) : sans chrome Windows natif
         (WindowStyle="None"), un simple ResizeMode="CanResize" ne donne aucune bordure
         attrapable à la souris — WindowChrome restaure des bords redimensionnables sur une
         fenêtre sans chrome, sans reprendre la barre de titre (CaptionHeight="0" laisse
         TitleBar_MouseLeftButtonDown/DragMove ci-dessous gérer le déplacement comme avant). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Triggers>
        <!-- Halos en respiration lente et continue (dérive + pulsation d'opacité) : signature
             discrète, jamais assez rapide pour distraire de l'UI. -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="-40" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="30" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="35" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="-25" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:11" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <!-- Halo de fond (signature Omnéria) : deux dégradés radiaux, violet et cyan. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="VioletHalo" Canvas.Left="520" Canvas.Top="-260" Width="620" Height="480">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#337B5CFF" Offset="0" />
                        <GradientStop Color="#007B5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="CyanHalo" Canvas.Left="-160" Canvas.Top="-40" Width="480" Height="360">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2200E5C7" Offset="0" />
                        <GradientStop Color="#0000E5C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) : libellé de la page à
                 gauche, pastille de mise à jour et boutons de fenêtre à droite. -->
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleLabel" Text="AL LAUNCHER · HUB" VerticalAlignment="Center" Margin="24,0,0,0"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                           Foreground="{StaticResource InkDimBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="UpdateBannerButton" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                            AutomationProperties.Name="Installer la mise à jour du launcher"
                            Style="{StaticResource OutlineButtonStyle}" Padding="10,5"
                            BorderBrush="#80FFB020" Foreground="{StaticResource AmberBrush}"
                            Click="UpdateBannerButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M13 2 4 14h7l-1 8 9-12h-7z" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="UpdateBannerText" Text="MISE À JOUR" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CompactModeButton" Content="⤢" Style="{StaticResource GhostButtonStyle}"
                            ToolTip="Mode compact" AutomationProperties.Name="Basculer le mode compact"
                            Click="CompactModeButton_Click" />
                    <Button Content="—" Style="{StaticResource GhostButtonStyle}" Click="MinimizeButton_Click"
                            ToolTip="Réduire" AutomationProperties.Name="Réduire la fenêtre" />
                    <Button Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click"
                            ToolTip="Fermer" AutomationProperties.Name="Fermer le launcher" />
                </StackPanel>
            </Grid>

            <!-- Barre latérale : marque, navigation par pages, profil connecté en bas. -->
            <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" />

                <Image Grid.Row="0" Source="/Assets/Images/omneria-mark.png" Width="96" Height="96" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,10,0,16" />

                <StackPanel Grid.Row="1">
                    <controls:NavButton x:Name="NavJouer" Content="HUB" IsActive="True"
                                        IconData="M3 12 12 3l9 9M5 10v10h14V10"
                                        Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Hub"
                                        Click="HubNavItem_Click" />
                    <controls:NavButton x:Name="NavActus" Content="ACTUS"
                                        IconData="M4 5h16v14H4zM8 9h8M8 13h5"
                                        Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Actus"
                                        Click="ActusNavItem_Click" />
                    <controls:NavButton x:Name="NavServeur" Content="SERVEUR"
                                        IconData="M4 6h16v5H4zM4 13h16v5H4zM7 8.5h.01M7 15.5h.01"
                                        Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Statut du serveur"
                                        Click="ServeurNavItem_Click" />
                    <controls:NavButton x:Name="NavParametres" Content="PARAMÈTRES"
                                        IconData="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM3 12h2m14 0h2M12 3v2m0 14v2"
                                        Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Paramètres"
                                        Click="ParametresNavItem_Click" />
                </StackPanel>

                <!-- Bloc profil : SE CONNECTER tant qu'aucun compte n'est actif, puis avatar + pseudo
                     + pastille CONNECTÉ, version du launcher et dernière synchro. -->
                <Border Grid.Row="3" Padding="18,16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}"
                        Background="{StaticResource CyanWash04Brush}">
                    <StackPanel>
                        <Button x:Name="LoginButton" Content="SE CONNECTER" HorizontalAlignment="Stretch"
                                Style="{StaticResource OutlineButtonStyle}" Padding="0,10" FontSize="11"
                                Foreground="{StaticResource CyanBrush}" BorderBrush="{StaticResource CyanBrush}"
                                Click="LoginButton_Click" />

                        <StackPanel x:Name="SidebarAccountPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PlayerAvatarBorder" Width="40" Height="40" Margin="0,0,12,0"
                                        BorderBrush="{StaticResource CyanBrush}" BorderThickness="1"
                                        Background="{StaticResource Surface2Brush}"
                                        Cursor="Hand" ToolTip="Modifier mon skin Minecraft"
                                        AutomationProperties.Name="Modifier mon skin Minecraft"
                                        MouseLeftButtonUp="PlayerAvatarBorder_MouseLeftButtonUp">
                                    <Grid>
                                        <Path Data="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"
                                              Stroke="{StaticResource CyanBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform" />
                                        <Image x:Name="PlayerAvatarImage" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayerNameText" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="AvatarErrorHint" Text="⚠" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource MagentaBrush}"
                                                   Visibility="Collapsed" Cursor="Help" />
                                    </StackPanel>
                                    <controls:StatusPill x:Name="ConnectedPill" Compact="True" Margin="0,4,0,0"
                                                         HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="VersionText" Margin="0,10,0,0" Style="{StaticResource MetaTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Zone principale : le hub, ou l'une des pages (voir ShowPage). -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid x:Name="HubPage" Margin="26,12,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Bannière de maintenance (maquette « HUB hors ligne + maintenance »), optionnelle :
                         collapsed tant qu'aucun maintenance.txt n'est détecté. -->
                    <controls:BevelBorder x:Name="MaintenanceBanner" Grid.Row="0" Bevel="14" BorderThickness="1.5"
                                          BorderBrush="{StaticResource MagentaBrush}" Background="{StaticResource SurfaceBrush}"
                                          Padding="22,16" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M12 8v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"
                                  Stroke="{StaticResource MagentaBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SERVEUR EN MAINTENANCE" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource MagentaBrush}" />
                                <TextBlock x:Name="MaintenanceBannerTitle" FontFamily="{StaticResource DisplayFontFamily}"
                                           FontWeight="Bold" FontSize="17" Foreground="{StaticResource InkBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock x:Name="MaintenanceBannerSubtitle" FontSize="12"
                                           Foreground="{StaticResource InkDimBrush}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="MaintenanceBannerEndTimeBlock" Grid.Column="2" VerticalAlignment="Center"
                                        Margin="18,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="FIN ESTIMÉE" Style="{StaticResource EyebrowDimTextStyle}" FontSize="10"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="MaintenanceBannerEndTimeValue" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="24" FontWeight="Medium" Foreground="{StaticResource MagentaBrush}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </controls:BevelBorder>

                    <!-- Carte héros : serveur à gauche, JOUER (ou la liste d'étapes du lancement) à droite. -->
                    <controls:BevelBorder x:Name="ServerCardBorder" Grid.Row="1" Bevel="14" BorderThickness="1"
                                          BorderBrush="{StaticResource CyanEdgeBrush}" Background="{StaticResource SurfaceBrush}"
                                          Padding="30,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Image x:Name="HeroCrest" Grid.Column="0" Source="/Assets/Images/astral-nexus-crest.png"
                                   Width="150" Height="150" Stretch="UniformToFill" VerticalAlignment="Center"
                                   Margin="0,0,28,0" />

                            <StackPanel x:Name="HeroInfo" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SERVEUR" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock x:Name="ServerNameText" Margin="0,10,0,0" Text="ASTRAL NEXUS"
                                           FontFamily="{StaticResource DisplayFontFamily}" FontWeight="Bold" FontSize="34"
                                           Foreground="{StaticResource InkBrush}" />
                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                    <controls:StatusPill x:Name="ServerStatusPill" Margin="0,0,16,4"
                                                         ToolTipService.InitialShowDelay="300" />
                                    <TextBlock x:Name="ServerCountText" Style="{StaticResource MetaTextStyle}" Margin="0,0,16,4"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ServerLatencyText" Style="{StaticResource MetaTextStyle}" Margin="0,0,16,4"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="ServerCompatText" Style="{StaticResource MetaTextStyle}" Margin="0,0,16,4"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </WrapPanel>
                                <TextBlock x:Name="ServerMotdText" Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}"
                                           MaxWidth="420" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                           MaxHeight="40" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Bloc de droite : JOUER au repos, liste d'étapes pendant un lancement. -->
                            <Grid x:Name="HeroAction" Grid.Column="2" VerticalAlignment="Center" Margin="28,0,0,0">
                                <StackPanel x:Name="HeroReadyBlock" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=LoadingPanel}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button x:Name="PlayButton" Content="JOUER" HorizontalAlignment="Right"
                                            Style="{StaticResource HeroPlayButtonStyle}" Click="PlayButton_Click" />
                                    <TextBlock x:Name="HeroReadyMeta" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0"
                                               HorizontalAlignment="Right" />
                                    <Button x:Name="LaunchAnywayButton" Content="LANCER QUAND MÊME" HorizontalAlignment="Right"
                                            Margin="0,10,0,0" Padding="14,8" FontSize="11" Visibility="Collapsed"
                                            Style="{StaticResource OutlineButtonStyle}" Click="PlayButton_Click" />
                                    <Button x:Name="ViewLogsButton" Content="VOIR LES LOGS" HorizontalAlignment="Right"
                                            Margin="0,10,0,0" Padding="14,8" FontSize="11" Visibility="Collapsed"
                                            Style="{StaticResource DangerButtonStyle}" Click="ViewLogsButton_Click" />
                                </StackPanel>

                                <StackPanel x:Name="LoadingPanel" Width="380" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock x:Name="LaunchTitleText" Text="LANCEMENT" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock x:Name="LaunchCountText" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                                    </Grid>
                                    <ProgressBar x:Name="ProgressBar" Style="{StaticResource AppProgressBarStyle}" Margin="0,12,0,12" />
                                    <Ellipse x:Name="LoadingSpinner" Width="30" Height="30" StrokeThickness="3"
                                             Stroke="{StaticResource CyanBrush}" StrokeDashArray="4,3"
                                             RenderTransformOrigin="0.5,0.5" Margin="0,0,0,12" Visibility="Collapsed">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="LoadingSpinnerRotation" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="LoadingSpinnerRotation"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <controls:StepList x:Name="LaunchSteps" Visibility="Collapsed" RetryRequested="LaunchSteps_RetryRequested" />
                                    <TextBlock x:Name="LoadingStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                               Foreground="{StaticResource InkDimBrush}" Text="Préparation..." />
                                    <!-- Visible seulement pendant le pipeline de lancement (pas pendant une mise à
                                         jour du launcher) : interrompt l'étape en cours. -->
                                    <Button x:Name="CancelLaunchButton" Content="ANNULER" Visibility="Collapsed"
                                            HorizontalAlignment="Right" Margin="0,12,0,0" Padding="14,8" FontSize="11"
                                            AutomationProperties.Name="Annuler le lancement"
                                            Style="{StaticResource DangerButtonStyle}" Click="CancelLaunchButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </controls:BevelBorder>

                    <!-- Trois tuiles : dernière actu, modpack, notes du launcher. -->
                    <Grid x:Name="TilesGrid" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TileBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="DERNIÈRE ACTU" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock x:Name="NewsTileDate" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                                </Grid>
                                <TextBlock x:Name="NewsTileTitle" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource DisplayHeadingStyle}" FontSize="16" />
                                <TextBlock x:Name="NewsTileBody" Grid.Row="2" Margin="0,10,0,10" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" Text="Aucune actualité pour le moment." />
                                <Button Grid.Row="3" Content="TOUTES LES ACTUS" Style="{StaticResource TileLinkButtonStyle}"
                                        controls:NavButton.IconData="m9 6 6 6-6 6" Click="TileActusLink_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource TileBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="MODPACK" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock x:Name="ModpackTileAge" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                                </Grid>
                                <TextBlock x:Name="ModpackTileTitle" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource DisplayHeadingStyle}" FontSize="16" Text="Modpack" />
                                <TextBlock x:Name="ModpackTileBody" Grid.Row="2" Margin="0,10,0,10" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" Text="Aucune mise à jour du modpack pour le moment." />
                                <Button Grid.Row="3" Content="NOUVEAUTÉS DU PACK" Style="{StaticResource TileLinkButtonStyle}"
                                        controls:NavButton.IconData="m9 6 6 6-6 6" Click="TileModpackLink_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource TileBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="LAUNCHER" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                                    <controls:StatusPill x:Name="LauncherTilePill" Compact="True" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Text="Nouveautés de cette version"
                                           Style="{StaticResource DisplayHeadingStyle}" FontSize="16" />
                                <TextBlock x:Name="LauncherTileBody" Grid.Row="2" Margin="0,10,0,10" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" Text="Notes de version indisponibles pour le moment." />
                                <Button Grid.Row="3" Content="VOIR SUR GITHUB" Style="{StaticResource TileLinkButtonStyle}"
                                        controls:NavButton.IconData="M14 4h6v6M20 4 10 14M18 14v6H4V6h6" Click="TileLauncherLink_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Pages (v2.0.0) : elles remplacent le hub dans la même fenêtre (voir ShowPage). -->
                <Grid x:Name="PageHost" Margin="26,12,26,24" Visibility="Collapsed">
                    <controls:ActusPage x:Name="ActusPageView" Visibility="Collapsed" />
                    <controls:ServerPage x:Name="ServerPageView" Visibility="Collapsed" />
                    <controls:SettingsPage x:Name="SettingsPageView" Visibility="Collapsed" />
                    <controls:LogsPage x:Name="LogsPageView" Visibility="Collapsed" />
                    <controls:LegalPage x:Name="LegalPageView" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Notifications et dialogue intégrés (v2.0.0) : au-dessus de tout le reste. -->
        <controls:ToastHost x:Name="Toasts" />
        <controls:DialogHost x:Name="Dialogs" />
    </Grid>
</Window>
