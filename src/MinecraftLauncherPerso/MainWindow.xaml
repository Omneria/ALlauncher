<Window x:Class="MinecraftLauncherPerso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Algaron Launcher"
        Width="860" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/algaron-mark.png">
    <Window.Triggers>
        <!-- Halos en respiration lente et continue (dérive + pulsation d'opacité) : signature
             discrète, jamais assez rapide pour distraire de l'UI. -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="-40" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="30" Duration="0:0:14" />
                    <DoubleAnimation Storyboard.TargetName="VioletHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="X"
                                      From="0" To="35" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHaloTransform" Storyboard.TargetProperty="Y"
                                      From="0" To="-25" Duration="0:0:17" />
                    <DoubleAnimation Storyboard.TargetName="CyanHalo" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.55" Duration="0:0:11" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <!-- Halo de fond (signature Algaron) : deux dégradés radiaux, violet et cyan. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="VioletHalo" Canvas.Left="380" Canvas.Top="-260" Width="620" Height="480">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#337B5CFF" Offset="0" />
                        <GradientStop Color="#007B5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="CyanHalo" Canvas.Left="-160" Canvas.Top="-60" Width="480" Height="360">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanHaloTransform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2200E5C7" Offset="0" />
                        <GradientStop Color="#0000E5C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="/Assets/Images/algaron-mark.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="A L G A R O N   L A U N C H E R" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                               Foreground="{StaticResource InkDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource GhostButtonStyle}" Click="SettingsButton_Click" />
                    <Button Content="—" Style="{StaticResource GhostButtonStyle}" Click="MinimizeButton_Click" />
                    <Button Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Contenu principal -->
            <Grid Grid.Row="1" Margin="32,0,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bloc marque : logo Algaron officiel (hexagone + mot-symbole) -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,12">
                    <Image Source="/Assets/Images/algaron-lockup.png" Width="220" Stretch="Uniform" />
                    <TextBlock Text="L A U N C H E R" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                               Foreground="{StaticResource CyanBrush}" />
                </StackPanel>

                <!-- Barre de statut : état du serveur à gauche, profil connecté à droite, bandeau MAJ. -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ServerStatusText" Grid.Column="0" VerticalAlignment="Center"
                               Text="Vérification du serveur..." FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12" Foreground="{StaticResource InkDimBrush}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateBannerButton" Content="MISE À JOUR DISPONIBLE"
                                Visibility="Collapsed" Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="10,4"
                                FontSize="11" Foreground="{StaticResource AmberBrush}"
                                Click="UpdateBannerButton_Click" />
                        <Border x:Name="PlayerAvatarBorder" Width="26" Height="26" Margin="0,0,8,0"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Visibility="Collapsed">
                            <Image x:Name="PlayerAvatarImage" />
                        </Border>
                        <TextBlock x:Name="PlayerNameText" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                   Foreground="{StaticResource InkDimBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Panneau actus (news.txt optionnel) : masqué (Visibility=Collapsed, pas d'espace
                     réservé) tant qu'aucune actu n'est disponible. -->
                <Border x:Name="NewsPanel" Grid.Row="2" Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16" Visibility="Collapsed" MaxHeight="110">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📰 ACTUS" Style="{StaticResource EyebrowTextStyle}"
                                   Margin="16,12,16,4" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NewsText" Margin="16,0,16,12" TextWrapping="Wrap"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                       Foreground="{StaticResource InkBrush}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Panneau de chargement : masqué au repos, affiche un spinner + le statut de
                     l'étape en cours pendant le lancement (remplace l'ancien journal brut). Le
                     TextBox de journal est conservé hors-écran : AppendLog y écrit toujours,
                     consultable via VOIR LES LOGS en cas d'erreur. -->
                <Border x:Name="LoadingPanel" Grid.Row="3" Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource ColorCyan}" Offset="0" />
                                    <GradientStop Color="{StaticResource ColorViolet}" Offset="0.5" />
                                    <GradientStop Color="{StaticResource ColorMagenta}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="LoadingSpinner" Width="34" Height="34" StrokeThickness="3"
                                     Stroke="{StaticResource CyanBrush}" StrokeDashArray="4,3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LoadingSpinnerRotation" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingSpinnerRotation"
                                                                  Storyboard.TargetProperty="Angle"
                                                                  From="0" To="360" Duration="0:0:1.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="LoadingStatusText" Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                       Foreground="{StaticResource InkDimBrush}" Text="Préparation..." />
                        </StackPanel>
                        <TextBox x:Name="StatusLogTextBox" Grid.Row="1" Style="{StaticResource StatusLogStyle}"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Barre de contrôle : progression, bouton Jouer (RAM déplacée dans Paramètres) -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar" Grid.Row="0" Grid.ColumnSpan="3" Height="4" Margin="0,0,0,14"
                                 Minimum="0" Maximum="100"
                                 Background="{StaticResource Surface2Brush}" BorderThickness="0"
                                 Foreground="{StaticResource CyanBrush}" />

                    <Button x:Name="ViewLogsButton" Grid.Row="1" Grid.Column="1" Content="VOIR LES LOGS"
                            Visibility="Collapsed" Margin="0,0,12,0"
                            Style="{StaticResource GhostButtonStyle}" Width="Auto" Padding="12,4"
                            VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource MagentaBrush}"
                            Click="ViewLogsButton_Click" />

                    <Button x:Name="PlayButton" Grid.Row="1" Grid.Column="2" Content="JOUER"
                            Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"
                            Click="PlayButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
