<Window x:Class="MinecraftLauncherPerso.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omnéria Launcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <!-- Écran de démarrage : logo Omnéria en entrée dynamique (rotation + zoom, easing BackEase
         pour un léger effet de rebond), avant transition vers la fenêtre principale. Durées
         pilotées depuis le code-behind. -->
    <Window.Resources>
        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="LogoRotate" Storyboard.TargetProperty="Angle"
                              From="-18" To="0" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                              From="0.55" To="1" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                              From="0.55" To="1" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="HaloCyan" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:1.1" BeginTime="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="TaglineText" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.6" />
        </Storyboard>

        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                              From="1" To="0" Duration="0:0:0.4" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="420" Height="320">
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="HaloCyan" Canvas.Left="60" Canvas.Top="20" Width="300" Height="260" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3300E5C7" Offset="0" />
                        <GradientStop Color="#0000E5C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="-40" Canvas.Top="60" Width="220" Height="200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2A7B5CFF" Offset="0" />
                        <GradientStop Color="#007B5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="LogoImage" Source="/Assets/Images/omneria-mark.png" Width="200" Stretch="Uniform"
                   Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.55" ScaleY="0.55" />
                        <RotateTransform x:Name="LogoRotate" Angle="-18" />
                    </TransformGroup>
                </Image.RenderTransform>
                <Image.Effect>
                    <DropShadowEffect Color="#FF00E5C7" BlurRadius="36" ShadowDepth="0" Opacity="0.55" />
                </Image.Effect>
            </Image>
            <TextBlock x:Name="TaglineText" Text="C H A R G E M E N T…" HorizontalAlignment="Center" Margin="0,18,0,0"
                       Opacity="0" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{StaticResource InkDimBrush}" />
        </StackPanel>
    </Grid>
</Window>
