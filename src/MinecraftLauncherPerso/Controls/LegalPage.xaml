<UserControl x:Class="MinecraftLauncherPerso.Controls.LegalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftLauncherPerso.Controls"
             Focusable="False">
    <!-- Page Mentions légales (v2.0.0). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:TrackedText Grid.Column="0" Text="MENTIONS LÉGALES" Style="{StaticResource EyebrowTrackedStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="RETOUR" Style="{StaticResource OutlineButtonStyle}" Click="BackButton_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <controls:TrackedText Text="OMNÉRIA GAMES" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,20" Foreground="{StaticResource InkBrush}">
                    Outil non officiel développé pour un usage privé entre amis, sans lien avec Mojang,
                    Microsoft ou Minecraft. Fourni "en l'état", sans garantie. Ce launcher ne scanne rien
                    sur la machine du joueur et n'envoie aucune télémétrie : seules les requêtes réseau
                    nécessaires à son fonctionnement (Java, Forge, mods, authentification Microsoft, statut
                    du serveur, vérification de mise à jour, têtes des joueurs via mc-heads.net ou minotar.net) sont effectuées.
                </TextBlock>

                <controls:TrackedText Text="CODE SOURCE" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,6" />
                <TextBlock FontSize="13" Margin="0,0,0,20">
                    <Hyperlink NavigateUri="https://github.com/Omneria/ALlauncher" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource CyanBrush}">github.com/Omneria/ALlauncher</Hyperlink>
                </TextBlock>

                <controls:TrackedText Text="DÉPENDANCES OPEN SOURCE" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,10" />

                <StackPanel Margin="0,0,0,10">
                    <TextBlock FontSize="13" FontWeight="Bold">CmlLib.Core (MIT)</TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource InkDimBrush}" Margin="0,2,0,0">
                        Version vanilla, classpath, lancement du jeu.
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,2,0,0">
                        <Hyperlink NavigateUri="https://github.com/CmlLib/CmlLib.Core" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource CyanBrush}">github.com/CmlLib/CmlLib.Core</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock FontSize="13" FontWeight="Bold">CmlLib.Core.Installer.Forge (MIT)</TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource InkDimBrush}" Margin="0,2,0,0">
                        Installation de Forge.
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,2,0,0">
                        <Hyperlink NavigateUri="https://github.com/CmlLib/CmlLib.Core.Installer.Forge" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource CyanBrush}">github.com/CmlLib/CmlLib.Core.Installer.Forge</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock FontSize="13" FontWeight="Bold">Microsoft.Identity.Client — MSAL.NET (MIT)</TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource InkDimBrush}" Margin="0,2,0,0">
                        Authentification Microsoft OAuth.
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,2,0,0">
                        <Hyperlink NavigateUri="https://github.com/AzureAD/microsoft-authentication-library-for-dotnet" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource CyanBrush}">github.com/AzureAD/microsoft-authentication-library-for-dotnet</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock FontSize="13" FontWeight="Bold">Microsoft.Identity.Client.Extensions.Msal (MIT)</TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource InkDimBrush}" Margin="0,2,0,0">
                        Persistance chiffrée de la session Microsoft (reconnexion silencieuse).
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,2,0,0">
                        <Hyperlink NavigateUri="https://github.com/AzureAD/microsoft-authentication-extensions-for-dotnet" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource CyanBrush}">github.com/AzureAD/microsoft-authentication-extensions-for-dotnet</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <controls:TrackedText Text="POLICES EMBARQUÉES" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,6" />
                <TextBlock FontSize="13" TextWrapping="Wrap">
                    Chakra Petch, Inter, JetBrains Mono — licence SIL Open Font License 1.1.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
