<UserControl x:Class="MinecraftLauncherPerso.Controls.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftLauncherPerso.Controls"
             xmlns:local="clr-namespace:MinecraftLauncherPerso.Controls"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Page SERVEUR (maquette « SERVEUR — page dédiée ») : à gauche la carte du serveur, la
         disponibilité des dernières 24 h et le message du jour ; à droite les joueurs connectés et
         les notifications. L'historique vient du VPS (server-history.json). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Carte serveur -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/Images/astral-nexus-crest.png" Width="96" Height="96"
                               Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,22,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <controls:TrackedText Text="{Binding AddressText}" Style="{StaticResource EyebrowTrackedStyle}" Trim="True" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <local:StatusPill Kind="{Binding StatusKind}" LabelText="{Binding StatusText}" Hint="{Binding StatusHint}" VerticalAlignment="Center" />
                                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFontFamily}" FontWeight="Bold" FontSize="30"
                                           Foreground="{StaticResource CyanBrush}">
                                    <Run Text="{Binding PlayersOnline, Mode=OneWay}" /><Run Text="{Binding PlayersMax, Mode=OneWay}"
                                         FontSize="16" Foreground="{StaticResource InkDimBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Margin="0,0,18,0">
                                    <Run Text="LATENCE " /><Run Text="{Binding Latency, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MetaTextStyle}" Margin="0,0,18,0">
                                    <Run Text="VERSION " /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PROTOCOLE " Style="{StaticResource MetaTextStyle}" />
                                    <TextBlock Text="{Binding Protocol}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaTextStyle}">
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProtocolOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="JOUER" Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="52"
                                FontSize="14" Margin="22,0,0,0" VerticalAlignment="Center" Click="PlayButton_Click" />
                    </Grid>
                </Border>

                <!-- Disponibilité 24 h -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <controls:TrackedText Text="DISPONIBILITÉ · 24 DERNIÈRES HEURES" Style="{StaticResource EyebrowTrackedStyle}" />
                            <TextBlock Text="pings locaux, toutes les minutes" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Bars}" Height="32" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding BarHeight}" Margin="1.5,0" VerticalAlignment="Bottom"
                                            ToolTip="{Binding Tooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Up">
                                                        <Setter Property="Background" Value="{StaticResource CyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Partial">
                                                        <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Down">
                                                        <Setter Property="Background" Value="{StaticResource MagentaBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="−24 h" Style="{StaticResource MetaTextStyle}" />
                            <TextBlock Text="{Binding OutageText}" HorizontalAlignment="Center" Style="{StaticResource MetaTextStyle}"
                                       Foreground="{StaticResource MagentaBrush}" />
                            <TextBlock Text="maintenant" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                                   Style="{StaticResource MetaTextStyle}"
                                   Visibility="{Binding HistoryUnavailable, Converter={StaticResource BoolToVisibility}}"
                                   Text="Historique indisponible pour le moment (le serveur ne le publie pas encore, ou il est injoignable)." />
                    </StackPanel>
                </Border>

                <!-- Message du jour -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18">
                    <StackPanel>
                        <controls:TrackedText Text="MESSAGE DU JOUR" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Motd}" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{StaticResource Ink2Brush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Joueurs connectés -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <controls:TrackedText Text="JOUEURS CONNECTÉS" Style="{StaticResource EyebrowTrackedStyle}" />
                            <TextBlock Text="{Binding PlayersListCount}" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <TextBlock Text="Personne n'est connecté pour le moment." TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource InkDimBrush}" Margin="0,4,0,4"
                                   Visibility="{Binding NoPlayers, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Players}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,10,0">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MetaTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="La liste vient du ping serveur (échantillon), pas d'un mod client."
                                   Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18">
                    <StackPanel>
                        <controls:TrackedText Text="NOTIFICATIONS" Style="{StaticResource EyebrowTrackedStyle}" Margin="0,0,0,10" />
                        <CheckBox Content="Prévenir quand le serveur revient en ligne"
                                  IsChecked="{Binding NotifyServerBack, Mode=TwoWay}"
                                  Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,0,10" />
                        <CheckBox Content="Prévenir quand un ami se connecte"
                                  IsChecked="{Binding NotifyFriend, Mode=TwoWay}"
                                  Style="{StaticResource AppCheckBoxStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
