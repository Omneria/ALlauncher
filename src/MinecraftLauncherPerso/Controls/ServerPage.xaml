<UserControl x:Class="MinecraftLauncherPerso.Controls.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MinecraftLauncherPerso.Controls"
             Focusable="False">
    <!-- Page SERVEUR (maquette « SERVEUR — page dédiée ») : à gauche la carte du serveur, la
         disponibilité des dernières 24 h et le message du jour ; à droite les joueurs connectés et
         les notifications. L'historique vient du VPS (server-history.json). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Carte serveur -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/Images/astral-nexus-crest.png" Width="96" Height="96"
                               Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,22,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AddressText" Style="{StaticResource EyebrowTextStyle}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <local:StatusPill x:Name="StatusPill" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlayersCountText" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFontFamily}" FontWeight="Bold" FontSize="30"
                                           Foreground="{StaticResource CyanBrush}" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock x:Name="LatencyText" Style="{StaticResource MetaTextStyle}" Margin="0,0,18,0" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource MetaTextStyle}" Margin="0,0,18,0" />
                                <TextBlock x:Name="ProtocolText" Style="{StaticResource MetaTextStyle}" />
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="JOUER" Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="52"
                                FontSize="14" Margin="22,0,0,0" VerticalAlignment="Center" Click="PlayButton_Click" />
                    </Grid>
                </Border>

                <!-- Disponibilité 24 h -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="DISPONIBILITÉ · 24 DERNIÈRES HEURES" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="pings locaux, toutes les minutes" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <ItemsControl x:Name="AvailabilityBars" Height="32" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding BarHeight}" Margin="1.5,0" VerticalAlignment="Bottom"
                                            Background="{Binding Brush}" ToolTip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="−24 h" Style="{StaticResource MetaTextStyle}" />
                            <TextBlock x:Name="OutageText" HorizontalAlignment="Center" Style="{StaticResource MetaTextStyle}"
                                       Foreground="{StaticResource MagentaBrush}" />
                            <TextBlock Text="maintenant" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <TextBlock x:Name="HistoryUnavailableText" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Style="{StaticResource MetaTextStyle}" Visibility="Collapsed"
                                   Text="Historique indisponible pour le moment (le serveur ne le publie pas encore, ou il est injoignable)." />
                    </StackPanel>
                </Border>

                <!-- Message du jour -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="MESSAGE DU JOUR" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                        <TextBlock x:Name="MotdText" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{StaticResource Ink2Brush}" Text="Pas de message du jour." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Joueurs connectés -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="JOUEURS CONNECTÉS" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock x:Name="PlayersListCount" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" />
                        </Grid>
                        <TextBlock x:Name="NoPlayersText" Text="Personne n'est connecté pour le moment." TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource InkDimBrush}" Margin="0,4,0,4" />
                        <ItemsControl x:Name="PlayersList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MetaTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="La liste vient du ping serveur (échantillon), pas d'un mod client."
                                   Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="NotifyCheckBox" Content="Prévenir quand le serveur revient en ligne"
                                  Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,0,10"
                                  Checked="NotifyCheckBox_Changed" Unchecked="NotifyCheckBox_Changed" />
                        <CheckBox x:Name="FriendCheckBox" Content="Prévenir quand un ami se connecte"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  Checked="FriendCheckBox_Changed" Unchecked="FriendCheckBox_Changed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
