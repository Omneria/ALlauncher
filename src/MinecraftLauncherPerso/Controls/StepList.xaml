<UserControl x:Class="MinecraftLauncherPerso.Controls.StepList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Liste des étapes du lancement (maquette « Composants » et « HUB lancement ») : une ligne par
         étape de LaunchPipeline avec une pastille ronde (coche, arc de chargement, croix ou vide),
         le nom de l'étape et son détail à droite ; une étape en échec porte le lien RÉESSAYER. -->
    <ItemsControl x:Name="StepsControl" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Icon" Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                            BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                            VerticalAlignment="Center">
                        <Path x:Name="Glyph" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" />
                    </Border>
                    <TextBlock x:Name="Label" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                               Text="{Binding Label}" FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                               Foreground="{StaticResource InkDimBrush}" />
                    <TextBlock x:Name="Detail" Grid.Column="2" VerticalAlignment="Center" MaxWidth="200"
                               Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                               Foreground="{StaticResource InkDimBrush}" />
                    <Button x:Name="Retry" Grid.Column="2" Content="RÉESSAYER" Visibility="Collapsed"
                            VerticalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11" Foreground="{StaticResource CyanBrush}" Background="Transparent" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter TargetName="Icon" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        <Setter TargetName="Glyph" Property="Data" Value="m5 12 4 4 10-10" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink2Brush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Active">
                        <Setter TargetName="Icon" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        <Setter TargetName="Icon" Property="Background" Value="#2600E5C7" />
                        <Setter TargetName="Glyph" Property="Data" Value="M12 3a9 9 0 1 0 9 9" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource InkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter TargetName="Icon" Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
                        <Setter TargetName="Glyph" Property="Data" Value="M6 6l12 12M18 6 6 18" />
                        <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource MagentaBrush}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MagentaBrush}" />
                        <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Retry" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
