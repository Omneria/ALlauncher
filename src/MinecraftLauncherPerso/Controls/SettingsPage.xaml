<UserControl x:Class="MinecraftLauncherPerso.Controls.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Page Paramètres (v2.0.0) : remplace l'ancienne fenêtre modale. Sous-navigation à gauche
         (JEU / LAUNCHER / MAINTENANCE / À PROPOS), contenu défilant au centre, barre d'actions
         ENREGISTRER / RETOUR en bas. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PARAMÈTRES" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border x:Name="SubNavGame" Padding="12,9" BorderThickness="2,0,0,0" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="SubNav_MouseLeftButtonUp" KeyDown="SubNav_KeyDown">
                    <TextBlock x:Name="SubNavGameText" Text="JEU" Style="{StaticResource NavItemTextStyle}" />
                </Border>
                <Border x:Name="SubNavLauncher" Padding="12,9" BorderThickness="2,0,0,0" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="SubNav_MouseLeftButtonUp" KeyDown="SubNav_KeyDown">
                    <TextBlock x:Name="SubNavLauncherText" Text="LAUNCHER" Style="{StaticResource NavItemTextStyle}" />
                </Border>
                <Border x:Name="SubNavMaintenance" Padding="12,9" BorderThickness="2,0,0,0" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="SubNav_MouseLeftButtonUp" KeyDown="SubNav_KeyDown">
                    <TextBlock x:Name="SubNavMaintenanceText" Text="MAINTENANCE" Style="{StaticResource NavItemTextStyle}" />
                </Border>
                <Border x:Name="SubNavAbout" Padding="12,9" BorderThickness="2,0,0,0" Cursor="Hand" Focusable="True"
                        MouseLeftButtonUp="SubNav_MouseLeftButtonUp" KeyDown="SubNav_KeyDown">
                    <TextBlock x:Name="SubNavAboutText" Text="À PROPOS" Style="{StaticResource NavItemTextStyle}" />
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- JEU -->
                        <StackPanel x:Name="GameSection">
                            <!-- Un seul slider à deux poignées : la poignée gauche ne peut pas dépasser
                                 la droite et inversement (contrainte appliquée en direct dans les
                                 Drag*), plage bornée par la RAM physique réelle de la machine — par
                                 construction, impossible de configurer une plage invalide. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RAM (MO)" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock x:Name="RamRangeValueText" Grid.Column="1" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12" Foreground="{StaticResource InkDimBrush}" />
                            </Grid>
                            <Canvas x:Name="RamRangeCanvas" Height="20" Margin="0,6,0,16"
                                    SizeChanged="RamRangeCanvas_SizeChanged">
                                <Border x:Name="RamRangeTrack" Height="4" Canvas.Top="8" Background="{StaticResource Surface2Brush}" />
                                <Border x:Name="RamRangeFill" Height="4" Canvas.Top="8" Background="{StaticResource CyanBrush}" />
                                <Thumb x:Name="RamMinThumb" Width="14" Height="14" Canvas.Top="3" Cursor="Hand"
                                       AutomationProperties.Name="RAM minimum" DragDelta="RamMinThumb_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource CyanBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="RamMaxThumb" Width="14" Height="14" Canvas.Top="3" Cursor="Hand"
                                       AutomationProperties.Name="RAM maximum" DragDelta="RamMaxThumb_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource CyanBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Canvas>
                            <!-- Besoin en RAM publié par le pack, masqué s'il est inconnu. -->
                            <TextBlock x:Name="RamPackHintText" TextWrapping="Wrap" Margin="0,-10,0,16"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="12"
                                       Foreground="{StaticResource InkDimBrush}" Visibility="Collapsed" />

                            <TextBlock Text="RÉSOLUTION DU JEU (0 = automatique)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ScreenWidthTextBox" Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox x:Name="ScreenHeightTextBox" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" />
                            </Grid>

                            <TextBlock Text="DOSSIER DE JEU" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GameDirectoryTextBox" Grid.Column="0" Style="{StaticResource AppTextBoxStyle}"
                                         IsReadOnly="True" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="PARCOURIR" Style="{StaticResource OutlineButtonStyle}"
                                        Click="BrowseButton_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- LAUNCHER -->
                        <StackPanel x:Name="LauncherSection" Visibility="Collapsed">
                            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                            <CheckBox x:Name="DesktopNotificationsCheckBox" Content="NOTIFICATIONS DESKTOP (SERVEUR EN LIGNE)"
                                      Style="{StaticResource AppCheckBoxStyle}" />
                        </StackPanel>

                        <!-- MAINTENANCE : réparation du modpack, journaux, retour à la version
                             précédente et rapport de problème. -->
                        <StackPanel x:Name="MaintenanceSection" Visibility="Collapsed">
                            <TextBlock Text="MAINTENANCE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="RepairButton" Grid.Row="0" Grid.Column="0" Content="RÉPARER LE MODPACK"
                                        Style="{StaticResource OutlineButtonStyle}" Click="RepairButton_Click" />
                                <Button x:Name="ViewLogsButton" Grid.Row="0" Grid.Column="2" Content="VOIR LES LOGS"
                                        Style="{StaticResource OutlineButtonStyle}" Click="ViewLogsButton_Click" />
                                <Button x:Name="RollbackButton" Grid.Row="2" Grid.Column="0" Content="REVENIR EN ARRIÈRE"
                                        Style="{StaticResource OutlineButtonStyle}" IsEnabled="False" Click="RollbackButton_Click" />
                                <Button x:Name="ReportProblemButton" Grid.Row="2" Grid.Column="2" Content="SIGNALER UN PROBLÈME"
                                        Style="{StaticResource OutlineButtonStyle}" Click="ReportProblemButton_Click" />
                            </Grid>
                            <TextBlock x:Name="RepairStatusText" FontSize="12" Foreground="{StaticResource InkDimBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- À PROPOS -->
                        <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                            <TextBlock Text="OMNÉRIA GAMES" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6" />
                            <TextBlock x:Name="AboutVersionText" FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,16" />
                            <TextBlock FontSize="13" Margin="0,0,0,16">
                                <Hyperlink NavigateUri="https://github.com/Omneria/ALlauncher" RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{StaticResource CyanBrush}">github.com/Omneria/ALlauncher</Hyperlink>
                            </TextBlock>
                            <Button Content="MENTIONS LÉGALES" HorizontalAlignment="Left"
                                    Style="{StaticResource OutlineButtonStyle}" Click="LegalButton_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Une saisie invalide (texte non numérique...) affiche pourquoi rien n'est enregistré. -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationErrorText" Grid.Column="0" Foreground="{StaticResource MagentaBrush}" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
            <Button Grid.Column="1" Content="RETOUR" Style="{StaticResource OutlineButtonStyle}"
                    Margin="0,0,12,0" VerticalAlignment="Center" Click="BackButton_Click" />
            <Button Grid.Column="2" Content="ENREGISTRER" Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</UserControl>
