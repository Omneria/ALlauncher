<UserControl x:Class="MinecraftLauncherPerso.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Pastille de statut (v2.0.0) : point coloré + libellé mono. Réutilisée par le hub et la page
         SERVEUR. Background transparent : sans lui, le survol entre le point et le texte ne
         déclenche pas l'infobulle (zone non hit-testable en WPF). -->
    <StackPanel Orientation="Horizontal" Background="Transparent">
        <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                 Fill="{StaticResource InkDimBrush}" />
        <TextBlock x:Name="Label" VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}"
                   FontSize="11" Foreground="{StaticResource InkDimBrush}" />
    </StackPanel>
</UserControl>
