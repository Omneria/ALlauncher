<UserControl x:Class="MinecraftLauncherPerso.Controls.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftLauncherPerso.Controls"
             Visibility="Collapsed" Focusable="False">
    <!-- Dialogue intégré à la fenêtre (v2.0.0), à la place des MessageBox Windows : un voile sur
         tout le launcher, une carte centrée au style de la charte, des boutons à la demande.
         Piloté par ShowAsync / ConfirmAsync / AlertAsync (DialogHost.xaml.cs). -->
    <Grid Background="#CC06080F">
        <!-- Maquette « dialogue intégré » : 440 px, filet de dégradé en tête, eyebrow + titre +
             message, puis un pied bordé qui porte les boutons. -->
        <Border x:Name="Card" Width="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="64" ShadowDepth="24" Direction="270" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <Rectangle Height="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource ColorCyan}" Offset="0" />
                            <GradientStop Color="{StaticResource ColorViolet}" Offset="0.5" />
                            <GradientStop Color="{StaticResource ColorMagenta}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Margin="24,22">
                    <controls:TrackedText x:Name="EyebrowText" Style="{StaticResource EyebrowTrackedStyle}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DisplayHeadingStyle}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"
                               FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                               Foreground="{StaticResource Ink2Brush}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,20">
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
