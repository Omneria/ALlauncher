<Window x:Class="MinecraftLauncherPerso.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue"
        Width="480" Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}"
        Icon="/Assets/Images/omneria-mark.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (fenêtre sans chrome Windows), comme SettingsWindow/LegalWindow.
             Un "✕" reste nécessaire malgré WindowStyle="None" (pas de chrome OS pour fermer sinon,
             hors Alt+F4) : ferme l'assistant à tout moment sans perdre les valeurs déjà choisies
             (GameDirectory initialisé dès le constructeur). -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="B I E N V E N U E" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{StaticResource InkDimBrush}" />

            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
        </Grid>

        <!-- Page 0 : accueil -->
        <StackPanel x:Name="Page0" Grid.Row="1" Margin="28,4,28,4" VerticalAlignment="Center">
            <TextBlock x:Name="WelcomeTitleText" Text="BIENVENUE SUR ASTRAL NEXUS" Style="{StaticResource EyebrowTextStyle}"
                       FontSize="14" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkDimBrush}" FontSize="13" LineHeight="20">
                Ce launcher installe automatiquement Java 8, Forge et le pack de mods du serveur,
                puis vous connecte avec votre compte Microsoft. Quelques étapes rapides avant de
                commencer.
            </TextBlock>
        </StackPanel>

        <!-- Page 1 : dossier de jeu -->
        <StackPanel x:Name="Page1" Grid.Row="1" Margin="28,4,28,4" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="DOSSIER DE JEU" Style="{StaticResource EyebrowTextStyle}" FontSize="14" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkDimBrush}" FontSize="13" Margin="0,0,0,12">
                Mods, config et sauvegardes seront installés ici. La valeur par défaut convient dans
                la plupart des cas ; changez-la seulement si vous savez pourquoi.
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDirectoryTextBox" Grid.Column="0" Style="{StaticResource AppTextBoxStyle}"
                         IsReadOnly="True" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="PARCOURIR" Style="{StaticResource GhostButtonStyle}" Width="Auto"
                        Padding="12,7" FontSize="11" Click="BrowseButton_Click" />
            </Grid>
        </StackPanel>

        <!-- Page 2 : dernière étape -->
        <StackPanel x:Name="Page2" Grid.Row="1" Margin="28,4,28,4" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="C'EST PRÊT" Style="{StaticResource EyebrowTextStyle}" FontSize="14" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkDimBrush}" FontSize="13">
                Cliquez sur "SE CONNECTER" ou directement sur "JOUER" dans le tableau de bord pour
                vous authentifier avec votre compte Microsoft — le launcher se charge du reste
                (Java, Forge, mods).
            </TextBlock>
        </StackPanel>

        <!-- Navigation -->
        <Grid Grid.Row="2" Margin="28,0,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StepIndicatorText" Grid.Column="0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       Foreground="{StaticResource InkDimBrush}" Text="1 / 3" />

            <Button x:Name="PreviousButton" Grid.Column="1" Content="PRÉCÉDENT" Style="{StaticResource GhostButtonStyle}"
                    Width="Auto" Padding="12,7" FontSize="11" Margin="0,0,8,0" Click="PreviousButton_Click"
                    Visibility="Collapsed" />

            <Button x:Name="NextButton" Grid.Column="2" Content="SUIVANT" Style="{StaticResource PrimaryButtonStyle}"
                    Width="140" Height="40" FontSize="12" Click="NextButton_Click" />
        </Grid>
    </Grid>
</Window>
