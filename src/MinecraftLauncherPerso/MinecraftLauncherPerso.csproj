<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MinecraftLauncherPerso</RootNamespace>
    <AssemblyName>AL Launcher</AssemblyName>
    <!-- Comparée par GitHubUpdateService à la dernière release GitHub (tag v*.*.*) pour l'auto-update.
         À incrémenter au même commit que chaque tag/release (règle de versionnage détaillée dans
         le README, section "Mise à jour automatique du launcher") :
           - correctif/bugfix sans nouveau comportement -> patch   (x.y.Z)
           - ajout non structurel, nouvelle fonctionnalité         -> minor (x.Y.0)
           - gros ajout structurel, changement cassant             -> major (X.0.0) -->
    <Version>1.11.0</Version>
    <!-- Métadonnées de l'exe (Propriétés → Détails dans l'explorateur Windows). -->
    <Product>AL Launcher</Product>
    <Company>Omneria</Company>
    <Description>Launcher Minecraft du serveur Astral Nexus</Description>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <!-- Pas de .pdb dans les builds publiées : symboles de debug inutiles pour l'utilisateur final. -->
    <DebugType>None</DebugType>
    <!-- NE PAS activer <InvariantGlobalization> : essayé en v1.9.2 pour réduire la taille du build,
         provoquait un crash silencieux au tout premier démarrage (fermeture immédiate, aucun
         message) — limitation connue de WPF, dont le sous-système de mise en forme de texte
         dépend des données ICU même quand le code applicatif n'utilise aucune culture spécifique. -->
    <ApplicationIcon>Assets\Images\omneria-mark.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Référence directe à l'assembly WinForms (plutôt que <UseWindowsForms>true</UseWindowsForms>)
         pour System.Windows.Forms.NotifyIcon (notifications desktop, DesktopNotificationService.cs) :
         UseWindowsForms ajoute en plus des "implicit usings" globaux pour System.Windows.Forms, qui
         entrent en collision avec System.Windows (WPF) sur des noms comme Application/TextBox/
         KeyEventArgs utilisés sans préfixe partout ailleurs dans le projet (CS0104, référence
         ambiguë). Cette référence seule donne accès au type sans ce comportement global. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <!-- Gère la version vanilla, le classpath et le lancement du jeu (arguments JVM/jeu). -->
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <!-- Installation de Forge (mapping de version + téléchargement des libs Forge). -->
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <!-- Authentification Microsoft (navigateur système, flux OAuth interactif) pour obtenir la session Minecraft. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <!-- Persistance officielle du cache de token MSAL (chiffré via DPAPI sur Windows) : plus
         robuste que la sérialisation manuelle pour garantir une reconnexion silencieuse fiable
         d'un lancement à l'autre. -->
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.66.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Polices embarquées (charte Omnéria) : Chakra Petch (titres), Inter (corps), JetBrains Mono
         (données/RAM/logs). Licence SIL Open Font License, textes conservés à côté des .ttf.
         None Remove évite un conflit avec le glob implicite du SDK (sinon inclus deux fois). -->
    <None Remove="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo Omnéria et crest du serveur Astral Nexus (fournis par l'utilisateur), recadrés en
         carré et retouchés (contraste/saturation/netteté) : omneria-mark.png/.ico (marque, aussi
         icône de l'exécutable) et astral-nexus-crest.png (badge serveur). -->
    <None Remove="Assets\Images\*.png" />
    <Resource Include="Assets\Images\*.png" />
  </ItemGroup>

</Project>
